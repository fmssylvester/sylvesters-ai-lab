Content-Type: text/css
Content-Transfer-Encoding: binary
Content-Location: https://client.crisp.chat/static/stylesheets/client_default_40382a0.css

@charset "utf-8";

.crisp-client { line-height: 1; text-align: left !important; color: rgb(var(--crisp-color-base-black-normal)) !important; direction: ltr !important; font-size: medium !important; font-style: normal !important; font-weight: 400 !important; text-decoration: none !important; list-style-type: disc !important; }

.crisp-client[dir="rtl"] { text-align: right !important; direction: rtl !important; }

.crisp-client[dir="rtl"] select, .crisp-client[dir="rtl"] textarea, .crisp-client[dir="rtl"] input { text-align: right !important; }

.crisp-client[dir="rtl"] textarea { margin-inline: 0px 4px !important; }

.crisp-client *, .crisp-client ::before, .crisp-client ::after { height: auto; line-height: inherit; min-height: 0px; max-height: none; clear: none !important; clip: auto !important; color: inherit !important; counter-increment: none !important; counter-reset: none !important; cursor: auto !important; direction: inherit !important; float: none !important; font-family: inherit !important; font-size: inherit !important; font-style: inherit !important; font-variant: normal !important; font-weight: inherit !important; letter-spacing: normal !important; list-style-type: inherit !important; quotes: "" "" !important; table-layout: auto !important; min-width: 0px !important; max-width: none !important; text-align: inherit !important; text-decoration: inherit !important; text-indent: 0px !important; text-transform: none !important; text-rendering: auto !important; vertical-align: baseline !important; visibility: inherit !important; white-space: normal !important; word-spacing: normal !important; z-index: auto !important; width: auto !important; box-shadow: none !important; box-sizing: content-box !important; columns: auto !important; column-rule: medium none rgb(var(--crisp-color-base-black-normal)) !important; font-feature-settings: normal !important; perspective: none !important; perspective-origin: 50% center !important; backface-visibility: visible !important; text-shadow: none !important; word-break: normal !important; hyphens: manual !important; -webkit-tap-highlight-color: rgba(var(--crisp-color-base-black-normal), 0) !important; -webkit-text-fill-color: currentcolor !important; hyphenate-character: "‐" !important; unicode-bidi: normal !important; border-width: medium !important; border-style: none !important; border-color: currentcolor !important; border-image: initial !important; border-radius: 0px !important; column-gap: normal !important; margin: 0px !important; padding: 0px !important; list-style-image: none !important; list-style-position: outside !important; transition: all !important; display: inline !important; position: static !important; inset: auto !important; overflow: visible !important; }

.crisp-client, .crisp-client h3, .crisp-client h5, .crisp-client p, .crisp-client h1, .crisp-client dl, .crisp-client dt, .crisp-client h6, .crisp-client ol, .crisp-client form, .crisp-client option, .crisp-client pre, .crisp-client div, .crisp-client h2, .crisp-client caption, .crisp-client h4, .crisp-client ul, .crisp-client dd, .crisp-client fieldset, .crisp-client hr, .crisp-client article, .crisp-client dialog, .crisp-client figure, .crisp-client footer, .crisp-client header, .crisp-client hgroup, .crisp-client menu, .crisp-client nav, .crisp-client section, .crisp-client audio, .crisp-client video, .crisp-client address, .crisp-client blockquote, .crisp-client colgroup, .crisp-client main, .crisp-client progress, .crisp-client summary { display: block !important; }

.crisp-client h1, .crisp-client h2, .crisp-client h3, .crisp-client h4, .crisp-client h5, .crisp-client h6 { font-weight: 700 !important; }

.crisp-client h1 { padding: 0.25em 0px !important; font-size: 2em !important; }

.crisp-client h2 { padding: 0.3em 0px !important; font-size: 1.5em !important; }

.crisp-client h3 { padding: 0.35em 0px !important; font-size: 1.17em !important; }

.crisp-client h4 { font-size: 1em !important; }

.crisp-client h5 { font-size: 0.83em !important; }

.crisp-client p { margin: 1em 0px !important; }

.crisp-client table { border-collapse: collapse !important; border-spacing: 0px !important; display: table !important; }

.crisp-client thead { display: table-header-group !important; }

.crisp-client tbody { display: table-row-group !important; }

.crisp-client tfoot { display: table-footer-group !important; }

.crisp-client tr { display: table-row !important; }

.crisp-client th, .crisp-client td { padding: 2px !important; display: table-cell !important; }

.crisp-client ol, .crisp-client ul { margin: 1em 0px !important; }

.crisp-client ul li, .crisp-client ul ul li, .crisp-client ul ul ul li, .crisp-client ol li, .crisp-client ol ol li, .crisp-client ol ol ol li, .crisp-client ul ol ol li, .crisp-client ul ul ol li, .crisp-client ol ul ul li, .crisp-client ol ol ul li { margin-top: 0.08em !important; list-style-position: inside !important; }

