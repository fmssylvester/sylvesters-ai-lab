.org-info[data-v-bfe245e7] { display: flex; flex-direction: column; margin-left: 0.75rem; flex: 1 1 0%; min-width: 0px; }

.org-name[data-v-bfe245e7] { font-size: 0.875rem; line-height: 1.25rem; font-weight: 500; color: var(--secondary-dark-color); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.org-domain[data-v-bfe245e7] { font-size: 0.75rem; line-height: 1rem; color: var(--secondary-color); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

