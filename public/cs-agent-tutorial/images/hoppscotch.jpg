.crisp-client .emoji { height: 16px; width: 16px !important; }

.crisp-client .cc-kjrsr[data-size="large"] { line-height: 42px; font-size: 42px !important; }

.crisp-client .cc-1icrj, .crisp-client .cc-1icrj::placeholder, .crisp-client .cc-1icrj *, .crisp-client .cc-1icrj ::placeholder { font-family: "Crisp Noto Sans Regular", sans-serif !important; }

.crisp-client .cc-10cqs, .crisp-client .cc-10cqs::placeholder, .crisp-client .cc-10cqs *, .crisp-client .cc-10cqs ::placeholder { font-family: "Crisp Noto Sans Bold", sans-serif !important; }

.crisp-client .cc-1mciy, .crisp-client .cc-1mciy::placeholder, .crisp-client .cc-1mciy *, .crisp-client .cc-1mciy ::placeholder { font-family: "Hack Regular", monospace !important; }

.crisp-client[dir="rtl"] .cc-1icrj, .crisp-client[dir="rtl"] .cc-1icrj::placeholder, .crisp-client[dir="rtl"] .cc-1icrj *, .crisp-client[dir="rtl"] .cc-1icrj ::placeholder { font-family: Tahoma, sans-serif !important; }

.crisp-client[dir="rtl"] .cc-10cqs, .crisp-client[dir="rtl"] .cc-10cqs::placeholder, .crisp-client[dir="rtl"] .cc-10cqs *, .crisp-client[dir="rtl"] .cc-10cqs ::placeholder { font-family: Tahoma, sans-serif !important; font-weight: 700 !important; }

.crisp-client { font-family: "Crisp Noto Sans Regular", "Helvetica Neue", Helvetica, Arial, sans-serif !important; font-size: 11px !important; }

.crisp-client[dir="rtl"] { font-family: Tahoma, sans-serif !important; }

.crisp-client * { -webkit-font-smoothing: subpixel-antialiased !important; user-select: none !important; margin: 0px !important; padding: 0px !important; font-size: 11px !important; font-weight: 400 !important; }

.crisp-client input { letter-spacing: 0.8px !important; font-size: 12px !important; }

.crisp-client input, .crisp-client textarea { color: rgb(var(--crisp-color-text-black-normal)) !important; background: 0px 0px !important; border: 0px !important; outline-style: none !important; font-size: 11.2px !important; }

.crisp-client input::placeholder, .crisp-client textarea::placeholder { color: rgb(var(--crisp-color-placeholder-normal)) !important; -webkit-text-fill-color: rgb(var(--crisp-color-placeholder-normal)) !important; }

.crisp-client input:disabled::placeholder, .crisp-client textarea:disabled::placeholder { color: rgb(var(--crisp-color-placeholder-disabled)) !important; -webkit-text-fill-color: rgb(var(--crisp-color-placeholder-disabled)) !important; }

.crisp-client button { outline-style: none !important; }

.crisp-client a { cursor: pointer !important; outline-style: none !important; text-decoration: none !important; }

.crisp-client a:hover { cursor: pointer !important; }

.crisp-client a:focus-visible, .crisp-client [role="button"]:focus-visible { outline: 4px solid rgb(var(--crisp-color-theme-900)) !important; outline-offset: 3px !important; }

.crisp-client .cc-165wh { --lightningcss-light: initial !important; --lightningcss-dark:  !important; color-scheme: light !important; }

.crisp-client .cc-165wh[data-hidden="true"] .cc-2ob4j { display: none !important; }

.crisp-client .cc-165wh[data-color-mode="dark"] { --lightningcss-light:  !important; --lightningcss-dark: initial !important; color-scheme: dark !important; }

.crisp-client .cc-1h0yx, .crisp-client .cc-12zhm { text-decoration: underline !important; }

.crisp-client .cc-13ftx { clear: both !important; display: block !important; }

.crisp-client .cc-3rfgc, .crisp-client .cc-3rfgc * { user-select: text !important; }

#crisp-loader { display: none !important; }

