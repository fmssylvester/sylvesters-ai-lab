@keyframes cc-gn59g { 
  0% { opacity: 0; }
  100% { opacity: 1; }
}

@keyframes cc-mhf5g { 
  0% { opacity: 1; }
  100% { opacity: 0; }
}

@keyframes cc-1errn { 
  0% { opacity: 0; }
  50% { opacity: 1; }
  100% { opacity: 0; }
}

@keyframes cc-7knmf { 
  0% { opacity: 1; transform: scale(1); }
  100% { opacity: 0; transform: scale(2); }
}

@keyframes cc-150dr { 
  0% { opacity: 0; transform: scale3d(0.6, 0.6, 0.6); }
  80% { opacity: 0; transform: scale3d(0.9, 0.9, 0.9); }
  100% { opacity: 1; }
}

@keyframes cc-twrkv { 
  0% { opacity: 0; transform: translateY(4%); }
  100% { opacity: 1; transform: none; }
}

@keyframes cc-dmcwi { 
  0% { opacity: 0; transform: translate(100px); }
  100% { opacity: 1; transform: none; }
}

@keyframes cc-15hv7 { 
  0% { opacity: 0; transform: translate(-100px); }
  100% { opacity: 1; transform: none; }
}

@keyframes cc-gfeec { 
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

@keyframes cc-120ox { 
  0% { opacity: 1; }
  50% { opacity: 0.4; }
  100% { opacity: 1; }
}

@keyframes cc-1rpb5 { 
  0% { opacity: 0; transform: translateY(3%); }
  100% { opacity: 1; transform: none; }
}

@keyframes cc-1nnve { 
  0% { opacity: 1; }
  100% { opacity: 0; transform: translateY(2.5%); }
}

@keyframes cc-19jix { 
  0% { opacity: 0; transform: rotate(-10deg); }
  100% { opacity: 1; transform: rotate(0deg); }
}

@keyframes cc-i66dg { 
  0% { opacity: 1; transform: rotate(0deg); }
  100% { opacity: 0; transform: rotate(-10deg); }
}

