@charset "utf-8";

pre code.hljs { display: block; overflow-x: auto; padding: 1em; }

code.hljs { padding: 3px 5px; }

.hljs { color: rgb(201, 209, 217); background: rgb(13, 17, 23); }

.hljs-doctag, .hljs-keyword, .hljs-meta .hljs-keyword, .hljs-template-tag, .hljs-template-variable, .hljs-type, .hljs-variable.language_ { color: rgb(255, 123, 114); }

.hljs-title, .hljs-title.class_, .hljs-title.class_.inherited__, .hljs-title.function_ { color: rgb(210, 168, 255); }

.hljs-attr, .hljs-attribute, .hljs-literal, .hljs-meta, .hljs-number, .hljs-operator, .hljs-variable, .hljs-selector-attr, .hljs-selector-class, .hljs-selector-id { color: rgb(121, 192, 255); }

.hljs-regexp, .hljs-string, .hljs-meta .hljs-string { color: rgb(165, 214, 255); }

.hljs-built_in, .hljs-symbol { color: rgb(255, 166, 87); }

.hljs-comment, .hljs-code, .hljs-formula { color: rgb(139, 148, 158); }

