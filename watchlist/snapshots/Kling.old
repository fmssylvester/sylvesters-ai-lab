    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=3.0, user-scalable=yes"
    />
    <title>Kling AI Release Notes & Version History | Kling AI</title>
    <meta
      name="keywords"
      content="Release Notes,Version Management,Changelog,Software Updates,Product Updates"
    />
    <meta name="robots" content="all" />
    <meta
      name="description"
      content="Track the latest features, updates, and improvements in Kling AI. Check our version history to see how our AI tools continue to evolve and optimize."
    />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Kling AI Release Notes & Version History | Kling AI" />
    <meta
      property="og:description"
      content="Track the latest features, updates, and improvements in Kling AI. Check our version history to see how our AI tools continue to evolve and optimize."
    />
    <meta property="og:image" content="https://kling.ai/logo-180x180.png" />
    <meta property="og:url" content="https://kling.ai/release-note/release-history" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Kling AI Release Notes & Version History | Kling AI" />
    <meta
      name="twitter:description"
      content="Track the latest features, updates, and improvements in Kling AI. Check our version history to see how our AI tools continue to evolve and optimize."
    />
    <meta name="twitter:image" content="https://kling.ai/logo-180x180.png" />
    <script id="kling-breadcrumb-jsonld" type="application/ld+json">
      {"@context":"https://schema.org","@type":"BreadcrumbList","@id":"https://kling.ai/release-note/release-history#breadcrumb","itemListElement":[{"@type":"ListItem","position":1,"name":"Kling AI","item":"https://kling.ai"},{"@type":"ListItem","position":2,"name":"Release Notes","item":"https://kling.ai/release-note/release-history"}]}
    </script>
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Release Notes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="apple-touch-icon" href="/logo-180x180.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/logo-180x180.png" />
    <link rel="apple-touch-icon" sizes="167x167" href="/logo-167x167.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/logo-152x152.png" />
    <link rel="apple-touch-icon" sizes="80x80" href="/logo-80x80.png" />
    <link rel="apple-touch-icon" sizes="58x58" href="/logo-58x58.png" />
    <script>
      ;(function () {
        var pathname = window.location.pathname
        var normalizedPath = pathname
        if (normalizedPath !== '/' && normalizedPath.endsWith('/')) {
          normalizedPath = normalizedPath.slice(0, -1)
        }
        var canonicalUrl = window.location.origin.replace(/\/+$/, '') + normalizedPath

        var link = document.getElementById('kling-canonical')
        if (!link) {
          link = document.querySelector("link[rel='canonical']")
        }
        if (link) {
          link.href = canonicalUrl.split('?')[0].split('#')[0]
        } else {
          link = document.createElement('link')
          link.id = 'kling-canonical'
          link.rel = 'canonical'
          link.href = canonicalUrl.split('?')[0].split('#')[0]
          document.head.appendChild(link)
        }

        function setMeta(selector, attrs, content) {
          var meta = document.querySelector(selector)
          if (!meta) {
            meta = document.createElement('meta')
            Object.keys(attrs).forEach(function (key) {
              meta.setAttribute(key, attrs[key])
            })
            document.head.appendChild(meta)
          }
          meta.setAttribute('content', content)
        }

        function toTitleText(segment) {
          return segment
            .split(/[-_]+/)
            .filter(Boolean)
            .map(function (word) {
              return word.charAt(0).toUpperCase() + word.slice(1)
            })
            .join(' ')
        }

        function buildOgTitle(pathname) {
          if (pathname === '/release-note/release-history' || pathname === '/release-note') {
            return 'Kling AI Release Notes & Version History | Kling AI'
          }
          var parts = (pathname || '/release-note/release-history')
            .replace(/^\/+/, '')
            .split('/')
            .filter(function (part) {
              return part && part !== 'release-note'
            })
            .map(toTitleText)
          return parts.length ? 'Kling AI ' + parts.join(' ') : 'Kling AI Release Notes'
        }

        function buildMetaDescription(pathname) {
          if (pathname === '/release-note/release-preview') {
            return 'Preview upcoming Kling AI releases, planned product updates, and feature improvements before they launch.'
          }
          if (pathname === '/release-note/release-history' || pathname === '/release-note') {
            return 'Track the latest features, updates, and improvements in Kling AI. Check our version history to see how our AI tools continue to evolve and optimize.'
          }
          return 'Read Kling AI release history, product updates, changelogs, and shipped feature improvements.'
        }

        function setBreadcrumbJsonLd(pathname, pageName) {
          var origin = window.location.origin.replace(/\/+$/, '')
          var pageUrl = origin + pathname
          var itemListElement = [
            {
              '@type': 'ListItem',
              position: 1,
              name: 'Kling AI',
              item: origin
            },
            {
              '@type': 'ListItem',
              position: 2,
              name: 'Release Notes',
              item: origin + '/release-note/release-history'
            }
          ]
          if (pathname !== '/release-note' && pathname !== '/release-note/release-history') {
            itemListElement.push({
              '@type': 'ListItem',
              position: 3,
              name: pageName.replace(/^Kling AI\s*/, ''),
              item: pageUrl
            })
          }
          var script = document.getElementById('kling-breadcrumb-jsonld')
          if (!script) {
            script = document.createElement('script')
            script.id = 'kling-breadcrumb-jsonld'
            script.type = 'application/ld+json'
            document.head.appendChild(script)
          }
          script.textContent = JSON.stringify({
            '@context': 'https://schema.org',
            '@type': 'BreadcrumbList',
            '@id': pageUrl + '#breadcrumb',
            itemListElement: itemListElement
          })
        }

        var ogTitle = buildOgTitle(normalizedPath)
        var ogDescription = buildMetaDescription(normalizedPath)
        var ogImage = window.location.origin.replace(/\/+$/, '') + '/logo-180x180.png'
        setMeta('meta[name="description"]', { name: 'description' }, ogDescription)
        setMeta('meta[property="og:type"]', { property: 'og:type' }, 'website')
        setMeta('meta[property="og:title"]', { property: 'og:title' }, ogTitle)
        setMeta('meta[property="og:description"]', { property: 'og:description' }, ogDescription)
        setMeta('meta[property="og:image"]', { property: 'og:image' }, ogImage)
        setMeta('meta[property="og:url"]', { property: 'og:url' }, canonicalUrl)
        setMeta('meta[name="twitter:card"]', { name: 'twitter:card' }, 'summary_large_image')
        setMeta('meta[name="twitter:title"]', { name: 'twitter:title' }, ogTitle)
        setMeta('meta[name="twitter:description"]', { name: 'twitter:description' }, ogDescription)
        setMeta('meta[name="twitter:image"]', { name: 'twitter:image' }, ogImage)
        setBreadcrumbJsonLd(normalizedPath, ogTitle)
      })()
    </script>
