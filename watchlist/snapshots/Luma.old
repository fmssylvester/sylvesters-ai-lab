image\",\"asset\":{\"_ref\":\"image-d66394460cfd2bdc08613c136b6215753c081183-1582x918-png\",\"_type\":\"reference\"}},\"intro\":[{\"_key\":\"c3baecc31c57\",\"_type\":\"block\",\"children\":[{\"_key\":\"b69f7b0c7f82\",\"_type\":\"span\",\"marks\":[],\"text\":\"Luma Labs AI introduces Modify Video API - a powerful video to video tool that enables developers to programmatically transform and reimagine video content at scale.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"slug\":{\"_type\":\"slug\",\"current\":\"modify-video-api-release\"},\"title\":\"Modify Video API Release\"}}],[\"$\",\"$L12\",\"d9ee2055-ac3b-41d2-809f-413da0b0f91e\",{\"data\":{\"_id\":\"d9ee2055-ac3b-41d2-809f-413da0b0f91e\",\"_type\":\"changelogPost\",\"_updatedAt\":\"2025-07-23T14:49:40Z\",\"category\":{\"_createdAt\":\"2025-05-14T12:38:45Z\",\"_id\":\"aa942537-c86b-4251-a000-86fd9c7482be\",\"_rev\":\"yA1m02rtmrOQ94IrtWgAXy\",\"_type\":\"changelogCategory\",\"_updatedAt\":\"2025-05-14T12:39:12Z\",\"name\":\"Release\"},\"date\":\"2025-06-04T14:45:00.000Z\",\"image\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-6f584b3f42d00d066dc7cb857049eea9facfad38-2520x1440-png\",\"_type\":\"reference\"}},\"intro\":[{\"_key\":\"66477ffc200f\",\"_type\":\"block\",\"children\":[{\"_key\":\"b8910d97d0ac\",\"_type\":\"span\",\"marks\":[],\"text\":\"Transform your videos without mocap suits or green screens. Modify Video lets you change environments, styles, and elements while keeping authentic motion intact. Now available in Dream Machine.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"slug\":{\"_type\":\"slug\",\"current\":\"introducing-modify-video\"},\"title\":\"Modify Video: Shoot Once. Shape Infinitely\"}}],[\"$\",\"$L12\",\"48efe936-766e-4ccd-a838-bbd99943761e\",{\"data\":{\"_id\":\"48efe936-766e-4ccd-a838-bbd99943761e\",\"_type\":\"changelogPost\",\"_updatedAt\":\"2025-07-23T14:46:43Z\",\"category\":{\"_createdAt\":\"2025-05-14T12:38:45Z\",\"_id\":\"aa942537-c86b-4251-a000-86fd9c7482be\",\"_rev\":\"yA1m02rtmrOQ94IrtWgAXy\",\"_type\":\"changelogCategory\",\"_updatedAt\":\"2025-05-14T12:39:12Z\",\"name\":\"Release\"},\"date\":\"2025-05-09T12:39:00.000Z\",\"image\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-e1c48d8505556858b238c997a9b4b198958fe39b-1920x1080-jpg\",\"_type\":\"reference\"}},\"intro\":[{\"_key\":\"8263bc6ebafe\",\"_type\":\"block\",\"children\":[{\"_key\":\"91941c5120db\",\"_type\":\"span\",\"marks\":[],\"text\":\"Reframe lets you outpaint images and reframe videos in any direction. Upload your own content or use Dream Machine generations to expand, resize, and adapt for any platform.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"slug\":{\"_type\":\"slug\",\"current\":\"reframe-is-here\"},\"title\":\"Reframe Is Here: Outpaint, Resize, Expand\"}}],[\"$\",\"$L12\",\"a32aebfd-9f77-4946-a887-bb15a5bb56a9\",{\"data\":{\"_id\":\"a32aebfd-9f77-4946-a887-bb15a5bb56a9\",\"_type\":\"changelogPost\",\"_updatedAt\":\"2025-07-23T14:58:50Z\",\"category\":{\"_createdAt\":\"2025-05-14T12:38:45Z\",\"_id\":\"aa942537-c86b-4251-a000-86fd9c7482be\",\"_rev\":\"yA1m02rtmrOQ94IrtWgAXy\",\"_type\":\"changelogCategory\",\"_updatedAt\":\"2025-05-14T12:39:12Z\",\"name\":\"Release\"},\"date\":\"2025-04-18T14:30:00.000Z\",\"image\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-7516ca7e53b62d16915a86180149d372222d0cf3-1816x1022-png\",\"_type\":\"reference\"}},\"intro\":[{\"_key\":\"f2439ddfe855\",\"_type\":\"block\",\"children\":[{\"_key\":\"9816b227d31d\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"Luma Labs AI introduces Camera Angle Concepts - nine cinematic framing tools that deliver precise control over dramatic perspectives, intimate shots, and immersive viewer experiences through natural language prompts.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"slug\":{\"_type\":\"slug\",\"current\":\"camera-angle-concepts-launch\"},\"title\":\"New Camera Angle Concepts \"}}],[\"$\",\"$L12\",\"9e92031e-f4e0-410b-bb97-6d725e8c76af\",{\"data\":{\"_id\":\"9e92031e-f4e0-410b-bb97-6d725e8c76af\",\"_type\":\"changelogPost\",\"_updatedAt\":\"2025-07-23T14:50:39Z\",\"category\":{\"_createdAt\":\"2025-05-14T12:38:45Z\",\"_id\":\"aa942537-c86b-4251-a000-86fd9c7482be\",\"_rev\":\"yA1m02rtmrOQ94IrtWgAXy\",\"_type\":\"changelogCategory\",\"_updatedAt\":\"2025-05-14T12:39:12Z\",\"name\":\"Release\"},\"date\":\"2025-03-31T14:20:00.000Z\",\"image\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-21d98f3a45f6ee68694c6f2b14ceed7a8c312fd6-1828x1092-png\",\"_type\":\"reference\"}},\"intro\":[{\"_key\":\"773e140df265\",\"_type\":\"block\",\"children\":[{\"_key\":\"56c1616cab30\",\"_type\":\"span\",\"marks\":[],\"text\":\"Luma Labs AI introduces Camera Motion Concepts. The first set of learnable controls for Ray2 that enable reliable and composable camera motion through minimal training examples.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"slug\":{\"_type\":\"slug\",\"current\":\"camera-motion-concepts-launch\"},\"title\":\"Launching Camera Motion Concepts\"}}],[\"$\",\"$L12\",\"64f35529-10f2-4028-8ae2-20ec32157b9b\",{\"data\":{\"_id\":\"64f35529-10f2-4028-8ae2-20ec32157b9b\",\"_type\":\"changelogPost\",\"_updatedAt\":\"2025-07-23T15:23:32Z\",\"category\":{\"_createdAt\":\"2025-05-14T12:38:45Z\",\"_id\":\"aa942537-c86b-4251-a000-86fd9c7482be\",\"_rev\":\"yA1m02rtmrOQ94IrtWgAXy\",\"_type\":\"changelogCategory\",\"_updatedAt\":\"2025-05-14T12:39:12Z\",\"name\":\"Release\"},\"date\":\"2025-01-15T15:30:00.000Z\",\"image\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-ba2954ce517633ce0a7c6891251906149714e260-1260x530-png\",\"_type\":\"reference\"}},\"intro\":[{\"_key\":\"4da33ae2401d\",\"_type\":\"block\",\"children\":[{\"_key\":\"04d42ca349df\",\"_type\":\"span\",\"marks\":[],\"text\":\"Ray2 represents a revolutionary leap forward in AI video generation, built on Luma's new multi-modal architecture with \"},{\"_key\":\"0a2f1bda0c6e\",\"_type\":\"span\",\"marks\":[\"strong\"],\"text\":\"10x the compute power\"},{\"_key\":\"6e601557cfbf\",\"_type\":\"span\",\"marks\":[],\"text\":\" of Ray1. This marks the beginning of a new era in video generation technology.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"slug\":{\"_type\":\"slug\",\"current\":\"introducing-ray2\"},\"title\":\"Introducing Ray2\"}}],[\"$\",\"$L12\",\"61540900-6e55-4bae-8127-07cbd3c4f264\",{\"data\":{\"_id\":\"61540900-6e55-4bae-8127-07cbd3c4f264\",\"_type\":\"changelogPost\",\"_updatedAt\":\"2025-05-14T15:42:19Z\",\"category\":{\"_createdAt\":\"2025-05-14T12:38:45Z\",\"_id\":\"aa942537-c86b-4251-a000-86fd9c7482be\",\"_rev\":\"yA1m02rtmrOQ94IrtWgAXy\",\"_type\":\"changelogCategory\",\"_updatedAt\":\"2025-05-14T12:39:12Z\",\"name\":\"Release\"},\"date\":\"2024-11-20T14:17:00.000Z\",\"image\":{\"_type\":\"image\",\"asset\":{\"_ref\":\"image-f1f9d891479a0acdaa70b5e8ebea0aede9c694c7-2048x1170-jpg\",\"_type\":\"reference\"}},\"intro\":[{\"_key\":\"d7ea334f700c\",\"_type\":\"block\",\"children\":[{\"_key\":\"bd17fb719df0\",\"_type\":\"span\",\"marks\":[],\"text\":\"We're thrilled to introduce the all-new Dream Machine, designed to empower your creativity with cutting-edge tools and seamless access to innovative features.\"}],\"markDefs\":[],\"style\":\"normal\"}],\"slug\":{\"_type\":\"slug\",\"current\":\"welcome-to-the-all-new-dream-machine\"},\"title\":\"Welcome to the All New Dream Machine\"}}]]}]}]]}]\n"])</script><script>self.__next_f.push([1,"a:[\"$\",\"$L13\",null,{\"data\":{\"_createdAt\":\"2025-04-03T15:01:03Z\",\"_id\":\"topNavigation\",\"_rev\":\"Dyksds5pMdxjOJ11lHauJJ\",\"_system\":{\"base\":{\"id\":\"topNavigation\",\"rev\":\"gHKwkGs4Xi1feI6L91tdPO\"}},\"_type\":\"topNavigation\",\"_updatedAt\":\"2026-05-05T18:02:57Z\",\"cta\":{\"_type\":\"anchorLink\",\"label\":\"Sign In\",\"url\":\"https://app.lumalabs.ai\"},\"links\":[{\"_key\":\"24348eb210c9\",\"_type\":\"anchorLink\",\"blank\":false,\"label\":\"Product\",\"url\":\"/app\"},{\"_key\":\"28539a2d5e8f\",\"_type\":\"anchorLink\",\"blank\":false,\"label\":\"Pricing\",\"url\":\"/pricing\"},{\"_key\":\"2e