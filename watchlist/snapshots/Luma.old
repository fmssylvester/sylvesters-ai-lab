oduction%2Fd66394460cfd2bdc08613c136b6215753c081183-1582x918.png&amp;w=3840&amp;q=75"/></div><div class="relative grid grid-cols-[auto_1fr] gap-2"><div class="rounded-md border border-indigo-600/80 bg-indigo-600/30 px-3 py-0.5 text-sm text-indigo-300">Release</div><p class="ml-auto self-center text-sm text-secondary">June 24, 2025</p><h3 id="card-title-58e3cd78-dc5f-42b7-b081-1da5fb89bc81" class="col-span-2 mt-3 typo-h4">Modify Video API Release</h3><div class="col-span-2 text-sm text-secondary"><div><p>Luma Labs AI introduces Modify Video API - a powerful video to video tool that enables developers to programmatically transform and reimagine video content at scale.</p></div></div></div></div></a><a class="group relative block border-l border-primary/20 pb-20 pl-10 md:pl-14 before:content-[&quot; &quot;] before:absolute before:top-0 before:-left-1 before:aspect-square before:w-2 before:rounded-full before:border before:border-primary/70 before:bg-surface-primary before:transition-transform before:duration-300 before:ease-in-out can-hover:hover:before:scale-150" href="/changelog/introducing-modify-video"><div class="relative grid gap-6 md:grid-cols-2 before:content-[&quot; &quot;] before:absolute before:-inset-7 before:rounded-2xl before:bg-white/70 before:opacity-0 before:transition-opacity before:duration-300 before:ease-in-out can-hover:group-hover:before:opacity-10"><div class="relative aspect-video overflow-hidden rounded-xl border border-primary/20"><img alt="Modify Video: Shoot Once. Shape Infinitely" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F6f584b3f42d00d066dc7cb857049eea9facfad38-2520x1440.png&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F6f584b3f42d00d066dc7cb857049eea9facfad38-2520x1440.png&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F6f584b3f42d00d066dc7cb857049eea9facfad38-2520x1440.png&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F6f584b3f42d00d066dc7cb857049eea9facfad38-2520x1440.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F6f584b3f42d00d066dc7cb857049eea9facfad38-2520x1440.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F6f584b3f42d00d066dc7cb857049eea9facfad38-2520x1440.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F6f584b3f42d00d066dc7cb857049eea9facfad38-2520x1440.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F6f584b3f42d00d066dc7cb857049eea9facfad38-2520x1440.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F6f584b3f42d00d066dc7cb857049eea9facfad38-2520x1440.png&amp;w=3840&amp;q=75"/></div><div class="relative grid grid-cols-[auto_1fr] gap-2"><div class="rounded-md border border-indigo-600/80 bg-indigo-600/30 px-3 py-0.5 text-sm text-indigo-300">Release</div><p class="ml-auto self-center text-sm text-secondary">June 4, 2025</p><h3 id="card-title-d9ee2055-ac3b-41d2-809f-413da0b0f91e" class="col-span-2 mt-3 typo-h4">Modify Video: Shoot Once. Shape Infinitely</h3><div class="col-span-2 text-sm text-secondary"><div><p>Transform your videos without mocap suits or green screens. Modify Video lets you change environments, styles, and elements while keeping authentic motion intact. Now available in Dream Machine.</p></div></div></div></div></a><a class="group relative block border-l border-primary/20 pb-20 pl-10 md:pl-14 before:content-[&quot; &quot;] before:absolute before:top-0 before:-left-1 before: