F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2Fe1c48d8505556858b238c997a9b4b198958fe39b-1920x1080.jpg&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2Fe1c48d8505556858b238c997a9b4b198958fe39b-1920x1080.jpg&amp;w=3840&amp;q=75"/></div><div class="relative grid grid-cols-[auto_1fr] gap-2"><div class="rounded-md border border-indigo-600/80 bg-indigo-600/30 px-3 py-0.5 text-sm text-indigo-300">Release</div><p class="ml-auto self-center text-sm text-secondary">May 9, 2025</p><h3 id="card-title-48efe936-766e-4ccd-a838-bbd99943761e" class="col-span-2 mt-3 typo-h4">Reframe Is Here: Outpaint, Resize, Expand</h3><div class="col-span-2 text-sm text-secondary"><div><p>Reframe lets you outpaint images and reframe videos in any direction. Upload your own content or use Dream Machine generations to expand, resize, and adapt for any platform.</p></div></div></div></div></a><a class="group relative block border-l border-primary/20 pb-20 pl-10 md:pl-14 before:content-[&quot; &quot;] before:absolute before:top-0 before:-left-1 before:aspect-square before:w-2 before:rounded-full before:border before:border-primary/70 before:bg-surface-primary before:transition-transform before:duration-300 before:ease-in-out can-hover:hover:before:scale-150" href="/changelog/camera-angle-concepts-launch"><div class="relative grid gap-6 md:grid-cols-2 before:content-[&quot; &quot;] before:absolute before:-inset-7 before:rounded-2xl before:bg-white/70 before:opacity-0 before:transition-opacity before:duration-300 before:ease-in-out can-hover:group-hover:before:opacity-10"><div class="relative aspect-video overflow-hidden rounded-xl border border-primary/20"><img alt="New Camera Angle Concepts " loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F7516ca7e53b62d16915a86180149d372222d0cf3-1816x1022.png&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F7516ca7e53b62d16915a86180149d372222d0cf3-1816x1022.png&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F7516ca7e53b62d16915a86180149d372222d0cf3-1816x1022.png&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F7516ca7e53b62d16915a86180149d372222d0cf3-1816x1022.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F7516ca7e53b62d16915a86180149d372222d0cf3-1816x1022.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F7516ca7e53b62d16915a86180149d372222d0cf3-1816x1022.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F7516ca7e53b62d16915a86180149d372222d0cf3-1816x1022.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F7516ca7e53b62d16915a86180149d372222d0cf3-1816x1022.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F7516ca7e53b62d16915a86180149d372222d0cf3-1816x1022.png&amp;w=3840&amp;q=75"/></div><div class="relative grid grid-cols-[auto_1fr] gap-2"><div class="rounded-md border border-indigo-600/80 bg-indigo-600/30 px-3 py-0.5 text-sm text-indigo-300">Release</div><p class="ml-auto self-center text-sm text-secondary">April 18, 2025</p><h3 id="card-title-a32aebfd-9f77-4946-a887-bb15a5bb56a9" class="col-span-2 mt-3 typo-h4">New Camera Angle Concepts </h3><div class="col-span-2 text-sm text-secondary"><div><p><strong>Luma Labs AI introduces Camera Angle Concepts - nine cinematic framing tools that deliver precise control over dramatic perspectives, intimate shots, and immersive viewer experiences through natural language prompts.</strong></p></div></div></div></div></a><a class="group relative block border-l border-primary/20 pb-20 pl-10 md:pl-14 before:content-[&quot; &quot;] before:absolute before:top-0 before:-left-1 before:aspect-square before:w-2 before:rounded-full before:border before:border-primary/70 before:bg-surface-primary before:transition-transform before:duration-300 before:ease-in-out can-hover:hover:before:scale-150" href="/changelog/camera-motion-concepts-launch"><div class="relative grid gap-6 md:grid-cols-2 before:content-[&quot; &quot;] before:absolute before:-inset-7 before:rounded-2xl before:bg-white/70 before:opacity-0 before:transition-opacity before:duration-300 before:ease-in-out can-hover:group-hover:before:opacity-10"><div class="relative aspect-video overflow-hidden rounded-xl border border-primary/20"><img alt="Launching Camera Motion Concepts" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F21d98f3a45f6ee68694c6f2b14ceed7a8c312fd6-1828x1092.png&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F21d98f3a45f6ee68694c6f2b14ceed7a8c312fd6-1828x1092.png&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F21d98f3a45f6ee68694c6f2b14ceed7a8c312fd6-1828x1092.png&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F21d98f3a45f6ee68694c6f2b14ceed7a8c312fd6-1828x1092.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F21d98f3a45f6ee68694c6f2b14ceed7a8c312fd6-1828x1092.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F21d98f3a45f6ee68694c6f2b14ceed7a8c312fd6-1828x1092.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F21d98f3a45f6ee68694c6f2b14ceed7a8c312fd6-1828x1092.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F21d98f3a45f6ee68694c6f2b14ceed7a8c312fd6-1828x1092.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2F21d98f3a45f6ee68694c6f2b14ceed7a8c312fd6-1828x1092.png&amp;w=3840&amp;q=75"/></div><div class="relative grid grid-cols-[auto_1fr] gap-2"><div class="rounded-md border border-indigo-600/80 bg-indigo-600/30 px-3 py-0.5 text-sm text-indigo-300">Release</div><p class="ml-auto self-center text-sm text-secondary">March 31, 2025</p><h3 id="card-title-9e92031e-f4e0-410b-bb97-6d725e8c76af" class="col-span-2 mt-3 typo-h4">Launching Camera Motion Concepts</h3><div class="col-span-2 text-sm text-secondary"><div><p>Luma Labs AI introduces Camera Motion Concepts. The first set of learnable controls for Ray2 that enable reliable and composable camera motion through minimal training examples.</p></div></div></div></div></a><a class="group relative block border-l border-primary/20 pb-20 pl-10 md:pl-14 before:content-[&quot; &quot;] before:absolute before:top-0 before:-left-1 before:aspect-square before:w-2 before:rounded-full before:border before:border-primary/70 before:bg-surface-primary before:transition-transform before:duration-300 before:ease-in-out can-hover:hover:before:scale-150" href="/changelog/introducing-ray2"><div class="relative grid gap-6 md:grid-cols-2 before:content-[&quot; &quot;] before:absolute before:-inset-7 before:rounded-2xl before:bg-white/70 before:opacity-0 before:transition-opacity before:duration-300 before:ease-in-out can-hover:group-hover:before:opacity-10"><div class="relative aspect-video overflow-hidden rounded-xl border border-primary/20"><img alt="Introducing Ray2" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2Fba2954ce517633ce0a7c6891251906149714e260-1260x530.png&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2Fba2954ce517633ce0a7c6891251906149714e260-1260x530.png&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2Fba2954ce517633ce0a7c6891251906149714e260-1260x530.png&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2Fba2954ce517633ce0a7c6891251906149714e260-1260x530.png&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2Fba2954ce517633ce0a7c6891251906149714e260-1260x530.png&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2Fba2954ce517633ce0a7c6891251906149714e260-1260x530.png&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2Fba2954ce517633ce0a7c6891251906149714e260-1260x530.png&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2Fba2954ce517633ce0a7c6891251906149714e260-1260x530.png&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2Fba2954ce517633ce0a7c6891251906149714e260-1260x530.png&amp;w=3840&amp;q=75"/></div><div class="relative grid grid-cols-[auto_1fr] gap-2"><div class="rounded-md border border-indigo-600/80 bg-indigo-600/30 px-3 py-0.5 text-sm text-indigo-300">Release</div><p class="ml-auto self-center text-sm text-secondary">January 15, 2025</p><h3 id="card-title-64f35529-10f2-4028-8ae2-20ec32157b9b" class="col-span-2 mt-3 typo-h4">Introducing Ray2</h3><div class="col-span-2 text-sm text-secondary"><div><p>Ray2 represents a revolutionary leap forward in AI video generation, built on Luma&#x27;s new multi-modal architecture with <strong>10x the compute power</strong> of Ray1. This marks the beginning of a new era in video generation technology.</p></div></div></div></div></a><a class="group relative block border-l border-primary/20 pb-20 pl-10 md:pl-14 before:content-[&quot; &quot;] before:absolute before:top-0 before:-left-1 before:aspect-square before:w-2 before:rounded-full before:border before:border-primary/70 before:bg-surface-primary before:transition-transform before:duration-300 before:ease-in-out can-hover:hover:before:scale-150" href="/changelog/welcome-to-the-all-new-dream-machine"><div class="relative grid gap-6 md:grid-cols-2 before:content-[&quot; &quot;] before:absolute before:-inset-7 before:rounded-2xl before:bg-white/70 before:opacity-0 before:transition-opacity before:duration-300 before:ease-in-out can-hover:group-hover:before:opacity-10"><div class="relative aspect-video overflow-hidden rounded-xl border border-primary/20"><img alt="Welcome to the All New Dream Machine" loading="lazy" decoding="async" data-nimg="fill" class="object-cover" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" sizes="100vw" srcSet="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2Ff1f9d891479a0acdaa70b5e8ebea0aede9c694c7-2048x1170.jpg&amp;w=640&amp;q=75 640w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2Ff1f9d891479a0acdaa70b5e8ebea0aede9c694c7-2048x1170.jpg&amp;w=750&amp;q=75 750w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2Ff1f9d891479a0acdaa70b5e8ebea0aede9c694c7-2048x1170.jpg&amp;w=828&amp;q=75 828w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2Ff1f9d891479a0acdaa70b5e8ebea0aede9c694c7-2048x1170.jpg&amp;w=1080&amp;q=75 1080w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2Ff1f9d891479a0acdaa70b5e8ebea0aede9c694c7-2048x1170.jpg&amp;w=1200&amp;q=75 1200w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2Ff1f9d891479a0acdaa70b5e8ebea0aede9c694c7-2048x1170.jpg&amp;w=1920&amp;q=75 1920w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2Ff1f9d891479a0acdaa70b5e8ebea0aede9c694c7-2048x1170.jpg&amp;w=2048&amp;q=75 2048w, /_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2Ff1f9d891479a0acdaa70b5e8ebea0aede9c694c7-2048x1170.jpg&amp;w=3840&amp;q=75 3840w" src="/_next/image?url=https%3A%2F%2Fcdn.sanity.io%2Fimages%2F2ylxvaa2%2Fproduction%2Ff1f9d891479a0acdaa70b5e8ebea0aede9c694c7-2048x1170.jpg&amp;w=3840&amp;q=75"/></div><div class="relative grid grid-cols-[auto_1fr] gap-2"><div class="rounded-md border border-indigo-600/80 bg-indigo-600/30 px-3 py-0.5 text-sm text-indigo-300">Release</div><p class="ml-auto self-center text-sm text-secondary">November 20, 2024</p><h3 id="card-title-61540900-6e55-4bae-8127-07cbd3c4f264" class="col-span-2 mt-3 typo-h4">Welcome to the All New Dream Machine</h3><div class="col-span-2 text-sm text-secondary"><div><p>We&#x27;re thrilled to introduce the all-new Dream Machine, designed to empower your creativity with cutting-edge tools and seamless access to innovative features.</p></div></div></div></div></a></div></div></div></div><div class="dark [clip-path:inset(0)]"><div class="pointer-events-none fixed top-0 right-0 left-0 z-10 h-top-nav transform-gpu bg-surface-primary/80 backdrop-blur-xl"></div><footer class="container-lg flex flex-col gap-20 pb-20 md:pb-40"><div class="pointer-events-none"><div class="h-px w-full bg-surface-inverted-primary/30"></div></div><div class="grid grid-cols-1 gap-8 md:grid-cols-2"><div class="flex flex-col items-start justify-center gap-5"><a class="typo-h3 transition-opacity will-change-transform hover:opacity-70" href="/">Luma</a><div class="flex items